# Supabase — Project Settings → API. The secret key stays server-side only (never NEXT_PUBLIC_).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: a GitHub token (no scopes needed) raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Optional: your final domain, used for SEO metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=
